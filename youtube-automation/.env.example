# YouTube Data API v3 키 (무료, Google Cloud Console에서 발급)
YOUTUBE_API_KEY=your_youtube_api_key_here

# 쿠팡 파트너스 API 키 — 쇼핑 쇼츠(shorts.py)를 만들 때만 필요합니다.
# partners.coupang.com 가입 후 승인되면 '내 정보 → 오픈 API 키 발급'에서 받습니다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Pexels API 키 (무료, pexels.com/api 에서 발급)
# 롱폼 영상(main.py)의 배경 영상에 쓰입니다. 쇼츠만 만들 거면 필요 없습니다.
PEXELS_API_KEY=your_pexels_api_key_here

# (선택) Anthropic API 키 — script_writer.py를 API로 직접 돌리고 싶을 때만 필요
# Claude Code에서 직접 스크립트를 요청하면 이 키는 필요 없음
ANTHROPIC_API_KEY=
