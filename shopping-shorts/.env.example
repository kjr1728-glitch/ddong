# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env
#
# ElevenLabs 키 — https://elevenlabs.io/app/settings/api-keys
# 현재 계정의 무료 크레딧 범위 안에서만 사용합니다.
# PAYG / Auto Top Up 은 파이프라인이 켜지 않습니다.
ELEVENLABS_API_KEY=

# 선택 — 비워두면 계정의 첫 번째 음성을 씁니다.
# 사용 가능한 음성은 `python3 pipeline/tts_elevenlabs.py --voices` 로 확인하세요.
ELEVENLABS_VOICE_ID=
