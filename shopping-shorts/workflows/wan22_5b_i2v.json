{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 TI2V 5B (8GB VRAM부터)"},
    "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "텍스트 인코더"},
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE"},
    "inputs": {"vae_name": "wan2.2_vae.safetensors"}
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "shift"},
    "inputs": {"shift": 8.0, "model": ["1", 0]}
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": {"title": "시작 프레임"},
    "inputs": {"image": "start.png"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "긍정 프롬프트"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "부정 프롬프트"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": {"title": "이미지→영상 latent"},
    "inputs": {"width": 704, "height": 1280, "length": 121, "batch_size": 1, "vae": ["3", 0], "start_image": ["5", 0]}
  },
  "9": {
    "class_type": "KSampler",
    "_meta": {"title": "샘플러"},
    "inputs": {
      "seed": 0, "steps": 20, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0,
      "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": {"title": "디코드"},
    "inputs": {"samples": ["9", 0], "vae": ["3", 0]}
  },
  "11": {
    "class_type": "CreateVideo",
    "_meta": {"title": "영상 만들기"},
    "inputs": {"fps": 24, "images": ["10", 0]}
  },
  "12": {
    "class_type": "SaveVideo",
    "_meta": {"title": "저장"},
    "inputs": {"filename_prefix": "shopping_shorts/clip", "format": "mp4", "codec": "h264", "video": ["11", 0]}
  }
}
