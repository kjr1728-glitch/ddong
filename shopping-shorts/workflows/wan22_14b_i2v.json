{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 I2V 14B high-noise (16GB+ 권장)"},
    "inputs": {"unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 I2V 14B low-noise"},
    "inputs": {"unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "텍스트 인코더"},
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE (14B는 2.1 VAE)"},
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "5": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "shift high"},
    "inputs": {"shift": 8.0, "model": ["1", 0]}
  },
  "6": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "shift low"},
    "inputs": {"shift": 8.0, "model": ["2", 0]}
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {"title": "시작 프레임"},
    "inputs": {"image": "start.png"}
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "긍정 프롬프트"},
    "inputs": {"text": "", "clip": ["3", 0]}
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "부정 프롬프트"},
    "inputs": {"text": "", "clip": ["3", 0]}
  },
  "10": {
    "class_type": "WanImageToVideo",
    "_meta": {"title": "이미지→영상"},
    "inputs": {
      "width": 720, "height": 1280, "length": 81, "batch_size": 1,
      "positive": ["8", 0], "negative": ["9", 0], "vae": ["4", 0], "start_image": ["7", 0]
    }
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "1단계 (high noise)"},
    "inputs": {
      "add_noise": "enable", "noise_seed": 0, "steps": 20, "cfg": 3.5,
      "sampler_name": "euler", "scheduler": "simple",
      "start_at_step": 0, "end_at_step": 10, "return_with_leftover_noise": "enable",
      "model": ["5", 0], "positive": ["10", 0], "negative": ["10", 1], "latent_image": ["10", 2]
    }
  },
  "12": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "2단계 (low noise)"},
    "inputs": {
      "add_noise": "disable", "noise_seed": 0, "steps": 20, "cfg": 3.5,
      "sampler_name": "euler", "scheduler": "simple",
      "start_at_step": 10, "end_at_step": 10000, "return_with_leftover_noise": "disable",
      "model": ["6", 0], "positive": ["10", 0], "negative": ["10", 1], "latent_image": ["11", 0]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "_meta": {"title": "디코드"},
    "inputs": {"samples": ["12", 0], "vae": ["4", 0]}
  },
  "14": {
    "class_type": "CreateVideo",
    "_meta": {"title": "영상 만들기"},
    "inputs": {"fps": 16, "images": ["13", 0]}
  },
  "15": {
    "class_type": "SaveVideo",
    "_meta": {"title": "저장"},
    "inputs": {"filename_prefix": "shopping_shorts/clip", "format": "mp4", "codec": "h264", "video": ["14", 0]}
  }
}
